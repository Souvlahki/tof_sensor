<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="MobileBaseHardwareInterface" type="system">
        <hardware>
            <plugin>tof_hardware/TofHardwareInterface</plugin>
            <param name="port">/dev/ttyUSB1</param>
            <param name="baud_rate">230400</param>
        </hardware>

        <sensor name="base_tof_sensor_1_joint">
            <state_interface name="range"></state_interface>
        </sensor>

        <gpio name="base_tof_sensor_1_settings">
            <command_interface name="mode"></command_interface>
            <command_interface name="calibration"></command_interface>
            <command_interface name="sample_rate"></command_interface>
            <command_interface name="needs_calibration"></command_interface>
            <state_interface name="mode"></state_interface>
            <state_interface name="calibration"></state_interface>
            <state_interface name="sample_rate"></state_interface>
            <state_interface name="needs_calibration"></state_interface>
        </gpio>

        <joint name="base_left_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position"/>

        </joint>
        <joint name="base_right_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position"/>

        </joint>

        <gpio name="pid_settings">
            <command_interface name="Kp" />
            <command_interface name="Ki" />
            <state_interface name="Kp"/>
            <state_interface name="Ki"/>
        </gpio>

        <gpio name="motor_data">
            <state_interface name="left_requested_vel"/>
            <state_interface name="left_calculated_vel"/>
        </gpio>
    </ros2_control>

</robot>